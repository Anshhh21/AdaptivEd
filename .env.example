# ==============================================================================
# AdaptivEd (NeuroLearn) Environment Configuration Template
# Copy this file to `backend/.env` and populate the values below.
# ==============================================================================

# Application Runtime Mode: "development" | "staging" | "production" | "test"
ENVIRONMENT=development
PROJECT_NAME="AdaptivEd (NeuroLearn) Engine"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Cryptographic Secret Key (Used for session signing & JWT tokens)
# Generate a secure key in your terminal with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-random-32-byte-hex-string-for-production-security

# JWT Access Token Lifetime in Minutes (Default: 7 days = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection
# ------------------------------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=adaptived_db

# ------------------------------------------------------------------------------
# 2. Groq Cloud API (High-Throughput LLaMA-3.3-70B Multi-Agent Inference)
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 3. Telemetry Engine Thresholds
# ------------------------------------------------------------------------------
TELEMETRY_FLUSH_INTERVAL_MS=1000
DEFAULT_WPM_BASELINE=220
REGRESSION_PENALTY_WEIGHT=0.35

